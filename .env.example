# Auth.js / NextAuth v5 — required for Google login
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — prefer Auth.js names (aliases also accepted in code):
#   AUTH_GOOGLE_ID  or GOOGLE_CLIENT_ID
#   AUTH_GOOGLE_SECRET or GOOGLE_CLIENT_SECRET
# Google Cloud Console → Credentials → OAuth 2.0 Client
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://culture-connect-2q8c-three.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: canonical site URL on Vercel
# AUTH_URL=https://culture-connect-2q8c-three.vercel.app

# POSTGRES_URL is injected by Vercel when a Postgres store is linked. Leave empty locally.
POSTGRES_URL=

# B2 guest signals + B3 share tokens + B3b RSVP — optional KV/Upstash.
# Share keys: share:tok:<token>, share:visits:<token>, share:visitors:<token>,
# share:rsvp:<token>, share:rsvp:work:<workId>.
# Falls back to in-memory / stdout JSON lines.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Beta cohort label (cookie `cc_cohort` from `?cohort=beta30` also accepted).
CC_BETA_COHORT=beta30

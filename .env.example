# Auth.js / NextAuth v5 — required for Google login
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://culture-connect-2q8c-three.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: canonical URL (Vercel often infers; useful locally)
# AUTH_URL=http://localhost:3000
